---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ToolCard from '@/components/tools/ToolCard.astro';
import CategorySidebar from '@/components/tools/CategorySidebar.astro';
import { getCategoryBySlug } from '@/lib/categories';
import { getCollection } from 'astro:content';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';

interface Props {
  slug: string;
  locale?: Locale;
}

const { slug } = Astro.props;
const { locale = 'es' } = Astro.props;
const category = getCategoryBySlug(slug!);
const lang = getTranslations(locale);

const allTools = await getCollection('tools');
const categoryTools = allTools
  .filter((t) => t.data.category === slug)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const backHref = locale === 'en' ? '/en/categories' : '/categories';
---

<BaseLayout title={category?.name ?? (locale === 'en' ? 'Category' : 'Categoría')} description={category?.description} {locale}>
  <section class="relative overflow-hidden py-16 md:py-20 border-b border-border font-mono">
    <div class="absolute inset-0 bg-grid pointer-events-none opacity-30" />
    <div class="container mx-auto px-4 relative">
      <a href={backHref} class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground mb-6 transition-colors">
          <Icon name="tabler:chevron-left" class="text-current" width="12" height="12" />
          {lang.categories.back}
        </a>
        <p class="kicker mb-4">{category?.icon ? `// ${category.name.toUpperCase()}` : ''}</p>
        <h1 class="text-3xl md:text-4xl font-normal mb-3">{category?.name}</h1>
        <p class="text-sm text-muted-foreground max-w-2xl">{category?.description}</p>
    </div>
  </section>

  <section class="py-12 font-mono">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-[240px_1fr] gap-8">
        <CategorySidebar {locale} activeSlug={slug} />
        <div>
          <p class="text-sm text-muted-foreground mb-6">
            <span class="text-foreground">{categoryTools.length}</span> {categoryTools.length === 1 ? lang.categories.foundOne : lang.categories.foundOther}
          </p>
          {categoryTools.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {categoryTools.map((tool) => (
                <ToolCard tool={tool} {locale} />
              ))}
            </div>
          ) : (
            <div class="text-center py-20">
              <p class="text-muted-foreground text-sm">{lang.categories.empty}</p>
              <p class="text-muted-foreground text-xs mt-2">{lang.categories.emptySub}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
