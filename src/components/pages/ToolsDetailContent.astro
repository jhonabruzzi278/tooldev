---
import { Icon } from 'astro-icon/components';
import ToolLogo from '@/components/tools/ToolLogo.astro';
import ToolHowToUse from '@/components/tools/ToolHowToUse.astro';
import ToolWhenToUse from '@/components/tools/ToolWhenToUse.astro';
import ToolExamples from '@/components/tools/ToolExamples.astro';
import ToolTips from '@/components/tools/ToolTips.astro';
import AnimatedFAQ from '@/components/tools/AnimatedFAQ';
import AnimateOnScroll from '@/components/ui/AnimateOnScroll';
import ToolFeedback from '@/components/tools/ToolFeedback.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { getCategoryName, getCategoryBySlug } from '@/lib/categories';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';
import type { CollectionEntry } from 'astro:content';
import CopyForAI from '@/components/tools/CopyForAI';
import NpxInstallBadge from '@/components/tools/NpxInstallBadge';
import ToolShareButtons from '@/components/tools/ToolShareButtons';
import LicenseToggle from '@/components/tools/LicenseToggle';
import VerifiedBadge from '@/components/tools/VerifiedBadge.astro';
import ScreenshotGallery from '@/components/tools/ScreenshotGallery';
import FavoriteButton from '@/components/tools/FavoriteButton';
import { existsSync } from 'node:fs';

interface Props {
  tool: CollectionEntry<'tools'>;
  locale?: Locale;
}

const { tool, locale = 'es' } = Astro.props;
const { data } = tool;
const { Content } = await render(tool);
const category = getCategoryBySlug(data.category);
const lang = getTranslations(locale);

const allTools = await getCollection('tools');
const relatedTools = allTools.filter(
  (t) => t.data.category === data.category && t.id !== tool.id
).slice(0, 3);

const alternativeTools = data.alternatives
  ? allTools.filter((t) => data.alternatives!.includes(t.id))
  : [];

const backHref = locale === 'en' ? '/en/tools' : '/tools';

// Usa el array de screenshots del frontmatter si existe, si no usa detección legacy con existsSync
const screenshotPaths: string[] = data.screenshots && data.screenshots.length > 0
  ? data.screenshots
  : (() => {
      const base = `public/screenshots/${tool.id}`;
      const paths: string[] = [];
      if (existsSync(`${base}.webp`)) paths.push(`/screenshots/${tool.id}.webp`);
      let i = 2;
      while (existsSync(`${base}-${i}.webp`)) {
        paths.push(`/screenshots/${tool.id}-${i}.webp`);
        i++;
      }
      return paths;
    })();
const screenshotCount = screenshotPaths.length;
---

<BaseLayout title={data.name} description={data.description} {locale}>
  <article class="font-mono">
    <div class="relative overflow-hidden border-b border-border">
      <div class="absolute inset-0 bg-grid pointer-events-none opacity-30" />
      <div class="container mx-auto px-4 py-12 md:py-16 relative">
        <a href={backHref} class="inline-flex items-center gap-1 text-xs uppercase tracking-widest text-muted-foreground hover:text-foreground mb-6 transition-colors">
          <Icon name="tabler:chevron-left" class="text-current" width="12" height="12" />
          {lang.tools.back}
        </a>
        <div class="flex flex-wrap items-center gap-2 mb-4">
          {category && (
            <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">
              {category.name}
            </span>
          )}
          {data.openSource && (
            <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{lang.tools.openSource}</span>
          )}
          {data.verified && <VerifiedBadge locale={locale} />}
          <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{data.pricing}</span>
          <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{data.technicalLevel}</span>
          {data.license && (
            <LicenseToggle license={data.license} client:load />
          )}
        </div>
        <h1 class="text-3xl md:text-4xl font-normal mb-4 flex items-center gap-3">
          <ToolLogo toolName={data.name} size={40} />
          {data.name}
        </h1>
        <p class="text-sm md:text-base text-muted-foreground max-w-2xl">{data.description}</p>
        <div class="flex flex-wrap items-center gap-3 mt-5">
          <ToolShareButtons client:load toolName={data.name} toolUrl={Astro.url.href} />
          <FavoriteButton client:load toolId={tool.id} variant="button" size="md" />
        </div>
        <div class="flex flex-wrap gap-3 mt-4">
          <a
            href={data.officialSite}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-[3px] bg-primary text-primary-foreground text-sm hover:opacity-90 transition-opacity"
          >
            <Icon name="tabler:external-link" class="text-current" width="16" height="16" />
            {lang.tools.officialSite}
            <span class="ml-0.5">→</span>
          </a>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        <div class="lg:col-span-3 lg:order-2">
          {data.verified && (
            <div class="flex justify-center mb-4">
              <NpxInstallBadge client:load toolName={data.name} locale={locale} />
            </div>
          )}
          <div class="flex justify-end mb-4">
            <CopyForAI client:load
              toolName={data.name}
              toolCategory={getCategoryName(data.category)}
              toolOpenSource={data.openSource}
              toolDescription={data.description}
              toolAlternatives={data.alternatives ?? []}
              toolPricing={data.pricing}
              toolTechnicalLevel={data.technicalLevel}
              toolLicense={data.license ?? ''}
              toolTags={data.tags}
              toolOfficialSite={data.officialSite}
              toolGithub={data.github ?? ''}
              toolCompatibility={data.compatibility}
              toolFeatures={data.features}
              toolHowToUse={data.howToUse ?? []}
              toolWhenToUse={data.whenToUse ?? []}
              toolExamples={data.examples ?? []}
              toolTips={data.tips ?? []}
              toolFaq={data.faq ?? []}
              toolVerified={data.verified}
              locale={locale}
            />
          </div>

          {screenshotCount > 0 && (
            <ScreenshotGallery
              client:load
              toolId={tool.id}
              toolName={data.name}
              totalImages={screenshotCount}
              screenshotPaths={screenshotPaths}
            />
          )}

          {data.features.length > 0 && (
            <div class="mb-10 p-6 border border-border">
              <p class="kicker mb-4">{lang.tools.features}</p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {data.features.map((feature: string) => (
                  <li class="flex items-start gap-2 text-sm">
                    <span class="text-accent-lime shrink-0">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="mb-10 flex flex-wrap gap-2">
            {data.compatibility.map((platform: string) => (
              <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground inline-flex items-center gap-1">
                <Icon name="tabler:device-desktop" class="text-current" width="10" height="10" />
                {platform}
              </span>
            ))}
          </div>

          <div class="prose max-w-none">
            <Content />
          </div>

          {data.howToUse && (
            <>
              <div class="my-10 border-t border-border/50" />
              <AnimateOnScroll client:load>
                <ToolHowToUse steps={data.howToUse} title={lang.tools.howToUse + ' ' + data.name} />
              </AnimateOnScroll>
            </>
          )}

          {data.whenToUse && (
            <AnimateOnScroll client:load delay={0.1}>
              <ToolWhenToUse cases={data.whenToUse} title={lang.tools.whenToUse} />
            </AnimateOnScroll>
          )}

          {data.examples && (
            <AnimateOnScroll client:load delay={0.15}>
              <ToolExamples
                examples={data.examples}
                title={lang.tools.examples}
                inputLabel={lang.tools.input}
                outputLabel={lang.tools.output}
              />
            </AnimateOnScroll>
          )}

          {data.tips && (
            <AnimateOnScroll client:load delay={0.2}>
              <ToolTips tips={data.tips} title={lang.tools.tips} />
            </AnimateOnScroll>
          )}

          {data.faq && (
            <AnimatedFAQ client:load items={data.faq} title={lang.tools.faq} />
          )}

          <ToolFeedback
            toolName={data.name}
            reportLabel={lang.tools.reportBroken}
            feedbackLabel={lang.tools.sendFeedback}
          />

          {data.tags.length > 0 && (
            <div class="mt-10 pt-8 border-t border-border">
              <div class="flex flex-wrap gap-2">
                {data.tags.map((tag: string) => (
                  <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">#{tag}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <aside class="lg:col-span-1 lg:order-1">
          <div class="lg:sticky lg:top-24 flex flex-col gap-6">
            <div class="p-4 border border-border">
              <p class="kicker mb-3">{lang.tools.info}</p>
              <dl class="flex flex-col gap-3 text-sm">
                <div>
                  <dt class="text-muted-foreground text-xs">{lang.tools.category}</dt>
                  <dd>{getCategoryName(data.category)}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground text-xs">{lang.tools.price}</dt>
                  <dd class="capitalize">{data.pricing}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground text-xs">{lang.tools.level}</dt>
                  <dd class="capitalize">{data.technicalLevel}</dd>
                </div>
                <div>
                  <dt class="text-muted-foreground text-xs">{lang.tools.openSource}</dt>
                  <dd>{data.openSource ? lang.tools.yes : lang.tools.no}</dd>
                </div>
              </dl>
            </div>
          </div>
        </aside>
      </div>

      {alternativeTools.length > 0 && (
        <>
          <div class="my-10 border-t border-border" />
          <section class="font-mono">
            <p class="kicker mb-4">{lang.tools.alternatives}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 border-t border-l border-border">
              {alternativeTools.map((alt) => {
                const altHref = locale === 'en' ? `/en/tools/${alt.id}` : `/tools/${alt.id}`;
                const altCategory = getCategoryBySlug(alt.data.category);
                return (
                <a href={altHref} class="group flex items-start gap-4 p-4 border-r border-b border-border hover:bg-muted/40 transition-colors">
                  <ToolLogo toolName={alt.data.name} size={20} />
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 mb-0.5">
                      <h3 class="text-sm truncate">{alt.data.name}</h3>
                      {altCategory && (
                        <span class="text-[10px] px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{altCategory.name}</span>
                      )}
                    </div>
                    <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed">{alt.data.description}</p>
                  </div>
                  <Icon name="tabler:arrow-up-right" class="text-muted-foreground/50 group-hover:text-accent-lime transition-colors shrink-0 mt-1" width="14" height="14" />
                </a>
                );
              })}
            </div>
          </section>
        </>
      )}

      {relatedTools.length > 0 && (
        <>
          <div class="my-10 border-t border-border" />
          <section class="font-mono">
            <p class="kicker mb-4">{lang.tools.related}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-t border-l border-border">
              {relatedTools.map((rel) => {
                const relHref = locale === 'en' ? `/en/tools/${rel.id}` : `/tools/${rel.id}`;
                const relCategory = getCategoryBySlug(rel.data.category);
                return (
                <a href={relHref} class="group h-full flex flex-col p-4 border-r border-b border-border hover:bg-muted/40 transition-colors">
                  <div class="flex items-center gap-3 mb-2">
                    <ToolLogo toolName={rel.data.name} size={18} />
                    <div class="min-w-0">
                      <h3 class="text-sm truncate">{rel.data.name}</h3>
                      {relCategory && (
                        <span class="text-[10px] text-muted-foreground">{relCategory.name}</span>
                      )}
                    </div>
                  </div>
                  <p class="text-xs text-muted-foreground line-clamp-2 leading-relaxed flex-1">{rel.data.description}</p>
                  <div class="flex items-center gap-1 mt-3 text-xs text-muted-foreground group-hover:text-accent-lime transition-colors">
                    <span>{lang.tools.viewTool}</span>
                    <Icon name="tabler:arrow-right" class="text-current" width="12" height="12" />
                  </div>
                </a>
                );
              })}
            </div>
          </section>
        </>
      )}
    </div>
  </article>
</BaseLayout>
