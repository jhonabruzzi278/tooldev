---
import { Icon } from 'astro-icon/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Card } from '@/components/ui/card';
import { categories } from '@/lib/categories';
import { getCollection } from 'astro:content';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const lang = getTranslations(locale);

const tools = await getCollection('tools');

const categoriesWithCount = categories.map((cat) => ({
  ...cat,
  count: tools.filter((t) => t.data.category === cat.slug).length,
}));
---

<BaseLayout title={lang.categories.title} description={locale === 'en' ? 'Explore developer tools organized by category.' : 'Explora herramientas para desarrolladores organizadas por categoría.'} {locale}>
  <section class="relative overflow-hidden py-16 md:py-20 border-b border-border font-mono">
    <div class="absolute inset-0 bg-grid pointer-events-none opacity-30" />
    <div class="container mx-auto px-4 relative">
      <p class="kicker mb-4">{lang.home.categoriesKicker}</p>
      <h1 class="text-3xl md:text-4xl font-normal mb-3">{lang.categories.title}</h1>
      <p class="text-sm text-muted-foreground">{lang.categories.subtitle}</p>
    </div>
  </section>
  <section class="py-12 font-mono">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-t border-l border-border">
        {categoriesWithCount.map((cat) => {
          const catHref = locale === 'en' ? `/en/categories/${cat.slug}` : `/categories/${cat.slug}`;
          return (
          <a href={catHref} class="group block border-r border-b border-border p-6 hover:bg-muted/40 transition-colors">
            <Icon name={cat.icon} class="text-accent-lime mb-4" width="20" height="20" />
            <h3 class="text-sm mb-1">{cat.name}</h3>
            <p class="text-xs text-muted-foreground leading-relaxed mb-4">{cat.description}</p>
            <p class="text-xs text-muted-foreground">
              {cat.count} {cat.count === 1 ? lang.categories.count_one : lang.categories.count_other} <span class="inline-block ml-1 text-accent-lime transition-transform group-hover:translate-x-0.5">→</span>
            </p>
          </a>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
