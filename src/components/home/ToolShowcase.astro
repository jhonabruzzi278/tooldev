---
import ToolLogo from '@/components/tools/ToolLogo.astro';
import { getCollection } from 'astro:content';
import { getCategoryBySlug } from '@/lib/categories';
import { Icon } from 'astro-icon/components';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';
import AnimateOnScroll from '@/components/ui/AnimateOnScroll';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const lang = getTranslations(locale);

const allTools = await getCollection('tools');
const featuredTools = allTools.filter((t) => t.data.featured);

const pricingLabel: Record<string, string> = {
  gratis: locale === 'en' ? 'FREE' : 'GRATIS',
  freemium: 'FREEMIUM',
  pago: locale === 'en' ? 'PAID' : 'PAGO',
  'open-source': 'OPEN SOURCE',
};
---

<section class="py-16 border-t border-border font-mono">
  <div class="container mx-auto px-4">
    <AnimateOnScroll client:load>
      <p class="kicker mb-4">{lang.home.featuredKicker}</p>
      <div class="mb-10">
        <h2 class="text-2xl md:text-3xl font-normal mb-2">{lang.home.featuredTitle}</h2>
        <p class="text-sm text-muted-foreground">{lang.home.featuredSubtitle}</p>
      </div>
    </AnimateOnScroll>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-t border-l border-border">
      {featuredTools.map((tool) => {
        const toolHref = locale === 'en' ? `/en/tools/${tool.id}` : `/tools/${tool.id}`;
        const category = getCategoryBySlug(tool.data.category);

        return (
          <a href={toolHref} class="group relative block border-r border-b border-border p-5 hover:bg-muted/40 transition-colors">
            {tool.data.verified && (
              <span class="absolute top-3 right-3 text-accent-lime text-sm" aria-hidden="true">✦</span>
            )}
            <div class="flex items-center gap-2 mb-3">
              <ToolLogo toolName={tool.data.name} size={18} />
              <h3 class="text-sm truncate">{tool.data.name}</h3>
              <Icon name="tabler:arrow-up-right" class="text-muted-foreground/50 group-hover:text-accent-lime transition-colors shrink-0 ml-auto" width="14" height="14" />
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed mb-4 line-clamp-2">{tool.data.description}</p>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">
                {pricingLabel[tool.data.pricing] ?? tool.data.pricing}
              </span>
              {category && (
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">
                  {category.name}
                </span>
              )}
            </div>
          </a>
        );
      })}
    </div>

    <AnimateOnScroll client:load delay={0.2}>
      <div class="mt-8">
        <a href={locale === 'en' ? '/en/tools' : '/tools'} class="text-sm text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1 group">
          {lang.home.featuredAllFull}
          <Icon name="tabler:arrow-right" width="14" height="14" class="group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>
    </AnimateOnScroll>
  </div>
</section>
