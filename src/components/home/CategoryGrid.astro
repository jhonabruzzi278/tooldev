---
import { Icon } from 'astro-icon/components';
import { categories } from '@/lib/categories';
import { getCollection } from 'astro:content';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';
import AnimateOnScroll from '@/components/ui/AnimateOnScroll';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const lang = getTranslations(locale);

const tools = await getCollection('tools');

const categoriesWithCount = categories.map((cat) => ({
  ...cat,
  count: tools.filter((t) => t.data.category === cat.slug).length,
}));
---

<section class="py-16 border-t border-border font-mono">
  <div class="container mx-auto px-4">
    <AnimateOnScroll client:load>
      <p class="kicker mb-4">{lang.home.categoriesKicker}</p>
      <div class="mb-10">
        <h2 class="text-2xl md:text-3xl font-normal mb-2">{lang.categories.homeTitle}</h2>
        <p class="text-sm text-muted-foreground">{lang.categories.homeSubtitle}</p>
      </div>
    </AnimateOnScroll>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-t border-l border-border">
      {categoriesWithCount.map((cat) => {
        const catHref = locale === 'en' ? `/en/categories/${cat.slug}` : `/categories/${cat.slug}`;
        return (
        <a href={catHref} class="group block border-r border-b border-border hover:bg-muted/40 transition-colors">
          <div class="flex items-center gap-3 p-5">
            <Icon name={cat.icon} class="text-accent-lime shrink-0" width="18" height="18" />
            <div class="min-w-0 flex-1">
              <div class="text-sm">{cat.name}</div>
            </div>
            <span class="text-xs text-muted-foreground tabular-nums">{cat.count}</span>
            <Icon name="tabler:arrow-up-right" class="text-muted-foreground/50 group-hover:text-accent-lime transition-colors shrink-0" width="14" height="14" />
          </div>
        </a>
        );
      })}
    </div>
  </div>
</section>
