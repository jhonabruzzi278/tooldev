---
import ThemeToggle from './ThemeToggle';
import MobileMenu from './MobileMenu';
import LanguageSwitcher from './LanguageSwitcher';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';
import { Icon } from 'astro-icon/components';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const lang = getTranslations(locale);

const navLinks = [
  { href: locale === 'en' ? '/en/tools' : '/tools', label: lang.nav.tools },
  { href: locale === 'en' ? '/en/categories' : '/categories', label: lang.nav.categories },
  { href: locale === 'en' ? '/en/about' : '/about', label: lang.nav.about },
  { href: locale === 'en' ? '/en/contact' : '/contact', label: lang.nav.contact },
];

const currentPath = Astro.url.pathname;
const baseHref = locale === 'en' ? '/en' : '/';
const favoritesHref = locale === 'en' ? '/en/favorites' : '/favorites';
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-background/85 backdrop-blur-xl supports-[backdrop-filter]:bg-background/70 font-mono">
  <div class="container mx-auto flex h-14 items-center justify-between px-4">
    <a href={baseHref} class="flex items-center gap-1.5 text-sm tracking-tight">
      <span class="text-accent-lime">&gt;</span>
      <span class="hidden sm:inline">{lang.site.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => {
        const isActive = currentPath.startsWith(link.href) && link.href !== baseHref;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`relative py-2 text-xs uppercase tracking-widest transition-colors ${
              isActive
                ? 'text-foreground'
                : 'text-muted-foreground hover:text-foreground'
            }`}
          >
            {link.label}
            {isActive && (
              <span class="absolute -bottom-px left-0 right-0 h-px bg-accent-lime" />
            )}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={favoritesHref}
        class="inline-flex items-center justify-center size-8 rounded-[3px] border border-transparent text-muted-foreground hover:text-foreground hover:border-border transition-colors"
        aria-label={locale === 'en' ? 'View favorites' : 'Ver favoritos'}
        title={locale === 'en' ? 'View favorites' : 'Ver favoritos'}
      >
        <Icon name="tabler:heart" class="text-current" width="18" height="18" />
      </a>
      <LanguageSwitcher locale={locale} client:load />
      <ThemeToggle client:load />
      <MobileMenu client:load links={navLinks} locale={locale} />
    </div>
  </div>
</header>
