---
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const lang = getTranslations(locale);

const navLinks = [
  { href: locale === 'en' ? '/en/tools' : '/tools', label: lang.nav.tools },
  { href: locale === 'en' ? '/en/categories' : '/categories', label: lang.nav.categories },
  { href: locale === 'en' ? '/en/about' : '/about', label: lang.nav.about },
  { href: locale === 'en' ? '/en/contact' : '/contact', label: lang.nav.contact },
];
---

<footer class="relative border-t border-border font-mono">
  <div class="container mx-auto px-4 py-14 relative">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <a href={locale === 'en' ? '/en' : '/'} class="flex items-center gap-1.5 text-sm tracking-tight mb-4">
          <span class="text-accent-lime">&gt;</span>
          {lang.site.name}
        </a>
        <p class="text-xs text-muted-foreground leading-relaxed max-w-sm">
          {lang.site.footer}
        </p>
      </div>

      <div class="md:col-span-3">
        <h3 class="kicker mb-4">{lang.nav.tools}</h3>
        <ul class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="text-xs text-muted-foreground hover:text-foreground transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-4">
        <h3 class="kicker mb-4">{lang.contact.infoTitle}</h3>
        <ul class="flex flex-col gap-3">
          <li>
            <a href="mailto:jonathanguerra278@gmail.com" class="text-xs text-muted-foreground hover:text-foreground transition-colors">
              jonathanguerra278@gmail.com
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-border flex flex-col md:flex-row justify-between items-center gap-3 text-xs text-muted-foreground">
      <p>
        © {new Date().getFullYear()} {lang.site.name}. {lang.site.rights}
      </p>
      <p>
        {lang.site.developedBy} <span class="text-foreground">Jonathan Guerra</span>
      </p>
    </div>
  </div>
</footer>
