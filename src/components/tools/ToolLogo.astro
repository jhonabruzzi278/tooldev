---
import { readdirSync, existsSync } from 'node:fs';

interface Props {
  toolName: string;
  size?: number;
  class?: string;
}

const { toolName, size = 20, class: className } = Astro.props;

const logosDir = 'public/logos';
const localMap: Record<string, string> = {};
if (existsSync(logosDir)) {
  for (const file of readdirSync(logosDir)) {
    const extIdx = file.lastIndexOf('.');
    if (extIdx <= 0) continue;
    const ext = file.slice(extIdx + 1).toLowerCase();
    if (['svg', 'webp', 'png', 'jpg', 'jpeg', 'ico', 'gif'].includes(ext)) {
      const name = file.slice(0, extIdx);
      localMap[name] = `/logos/${encodeURIComponent(file)}`;
    }
  }
}

const src = localMap[toolName];
---

{
  src && (
    <span
      class={`inline-flex items-center justify-center shrink-0 overflow-hidden ${className || ''}`}
      style={{ width: `${size}px`, height: `${size}px` }}
    >
      <img src={src} alt={toolName} class="max-w-full max-h-full object-contain" loading="lazy" decoding="async" />
    </span>
  )
}
