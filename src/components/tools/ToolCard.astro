---
import { Icon } from 'astro-icon/components';
import ToolLogo from '@/components/tools/ToolLogo.astro';
import LicenseToggle from '@/components/tools/LicenseToggle';
import FavoriteButton from '@/components/tools/FavoriteButton';
import { getCategoryName, getCategoryBySlug } from '@/lib/categories';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';
import type { CollectionEntry } from 'astro:content';

interface Props {
  tool: CollectionEntry<'tools'>;
  locale?: Locale;
}

const { tool, locale = 'es' } = Astro.props;
const { data } = tool;
const category = getCategoryBySlug(data.category);
const lang = getTranslations(locale);
const toolHref = locale === 'en' ? `/en/tools/${tool.id}` : `/tools/${tool.id}`;

const pricingLabel: Record<string, string> = {
  gratis: locale === 'en' ? 'FREE' : 'GRATIS',
  freemium: 'FREEMIUM',
  pago: locale === 'en' ? 'PAID' : 'PAGO',
  'open-source': 'OPEN SOURCE',
};
---

<a href={toolHref} data-verified={data.verified ? 'true' : 'false'} class="group relative block h-full border border-border p-5 hover:bg-muted/40 transition-colors font-mono">
  {data.verified && (
    <span class="absolute top-4 right-11 text-accent-lime text-sm" aria-hidden="true">✦</span>
  )}
  <div class="absolute top-3 right-3 z-10">
    <FavoriteButton client:load toolId={tool.id} size="sm" />
  </div>
  <div class="flex items-center gap-2 mb-3 pr-16">
    <ToolLogo toolName={data.name} size={20} />
    <h3 class="text-sm truncate">{data.name}</h3>
  </div>

  <p class="text-xs text-muted-foreground leading-relaxed line-clamp-2 mb-4">{data.description}</p>

  <div class="flex items-center gap-2 flex-wrap">
    <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">
      {pricingLabel[data.pricing] ?? data.pricing}
    </span>
    {data.featured && (
      <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] bg-accent-lime text-accent-lime-foreground font-semibold inline-flex items-center gap-1">
        <Icon name="tabler:star" class="text-current" width="10" height="10" />
        {lang.tools.featured}
      </span>
    )}
    {category && (
      <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">
        {getCategoryName(data.category)}
      </span>
    )}
    {data.openSource && (
      <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground inline-flex items-center gap-1">
        <Icon name="tabler:code" class="text-current" width="10" height="10" />
        {lang.tools.openSource}
      </span>
    )}
    {data.license && (
      <LicenseToggle license={data.license} size="sm" client:load />
    )}
  </div>

  {data.tags.length > 0 && (
    <div class="flex items-center gap-2 flex-wrap mt-3 pt-3 border-t border-border">
      {data.tags.slice(0, 3).map((tag: string) => (
        <span class="text-[10px] px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{tag}</span>
      ))}
    </div>
  )}
</a>
