---
export interface HowToStep {
  step: number;
  title: string;
  description: string;
}

interface Props {
  steps: HowToStep[];
  title?: string;
}

const { steps, title = 'Cómo usar' } = Astro.props;
if (!steps || steps.length === 0) return;
---

<section class="mb-12 font-mono">
  <p class="kicker mb-6">{title}</p>
  <div class="flex flex-col gap-6">
    {steps.map((s) => (
      <div class="flex gap-5 group">
        <div class="flex-shrink-0 size-8 rounded-[3px] border border-border flex items-center justify-center text-xs text-muted-foreground group-hover:border-accent-lime group-hover:text-accent-lime transition-colors">
          {s.step}
        </div>
        <div class="min-w-0 pt-1">
          <h3 class="text-sm mb-1.5">{s.title}</h3>
          <p class="text-xs text-muted-foreground leading-relaxed">{s.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
