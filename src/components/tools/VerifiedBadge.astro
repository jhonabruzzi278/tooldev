---
import { Icon } from 'astro-icon/components';
import { getTranslations } from '@/lib/i18n/translations';
import type { Locale } from '@/lib/i18n/translations';

interface Props {
  locale?: Locale;
}

const { locale = 'es' } = Astro.props;
const lang = getTranslations(locale);
---

<span class="shrink-0 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-[2px] text-[10px] uppercase tracking-wider font-mono text-accent-lime border border-accent-lime">
  <Icon name="tabler:shield-check" class="text-current" width="10" height="10" />
  {lang.tools.verified}
</span>
