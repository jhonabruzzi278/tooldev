---
export interface Tip {
  text: string;
}

interface Props {
  tips: Tip[];
  title?: string;
}

const { tips, title = 'Tips y buenas prácticas' } = Astro.props;
if (!tips || tips.length === 0) return;
---

<section class="mb-12 font-mono">
  <p class="kicker mb-6">{title}</p>
  <ol class="flex flex-col gap-3">
    {tips.map((tip, i) => (
      <li class="flex items-start gap-3 p-4 border border-border hover:bg-muted/40 transition-colors">
        <span class="flex-shrink-0 size-6 rounded-[3px] border border-accent-lime flex items-center justify-center text-xs text-accent-lime">{i + 1}</span>
        <p class="text-xs text-muted-foreground leading-relaxed pt-0.5">{tip.text}</p>
      </li>
    ))}
  </ol>
</section>
