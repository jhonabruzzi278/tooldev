---
export interface UseCase {
  title: string;
  description: string;
}

interface Props {
  cases: UseCase[];
  title?: string;
}

const { cases, title = 'Cuándo usarlo' } = Astro.props;
if (!cases || cases.length === 0) return;
---

<section class="mb-12 font-mono">
  <p class="kicker mb-6">{title}</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 border-t border-l border-border">
    {cases.map((c) => (
      <div class="p-5 border-r border-b border-border hover:bg-muted/40 transition-colors">
        <h3 class="text-sm mb-2">{c.title}</h3>
        <p class="text-xs text-muted-foreground leading-relaxed">{c.description}</p>
      </div>
    ))}
  </div>
</section>
