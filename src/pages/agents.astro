---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const agents = [
  {
    id: 'claude',
    name: 'Claude',
    maker: 'Anthropic',
    description: 'Asistente de IA con razonamiento avanzado, análisis de código, escritura y respuestas largas precisas.',
    icon: 'tabler:brain',
    color: '#D97706',
    tags: ['código', 'análisis', 'escritura'],
    installCmd: 'npx tooldev-skills install claude',
    docsUrl: 'https://docs.anthropic.com',
    available: false,
  },
  {
    id: 'kiro',
    name: 'Kiro',
    maker: 'Amazon Web Services',
    description: 'IDE con IA integrada para spec-driven development. Genera requisitos, diseño y tareas automáticamente.',
    icon: 'tabler:rocket',
    color: '#6366F1',
    tags: ['ide', 'specs', 'tareas'],
    installCmd: 'npx tooldev-skills install kiro',
    docsUrl: 'https://kiro.dev',
    available: false,
  },
  {
    id: 'cursor',
    name: 'Cursor',
    maker: 'Cursor',
    description: 'Editor de código con IA que entiende tu codebase completo. Ideal para refactoring y generación de código.',
    icon: 'tabler:cursor-text',
    color: '#10B981',
    tags: ['editor', 'código', 'refactor'],
    installCmd: 'npx tooldev-skills install cursor',
    docsUrl: 'https://cursor.sh',
    available: false,
  },
  {
    id: 'codex',
    name: 'Codex',
    maker: 'OpenAI',
    description: 'Agente de código de OpenAI que puede ejecutar tareas de ingeniería completas en un sandbox seguro.',
    icon: 'tabler:code',
    color: '#059669',
    tags: ['código', 'agente', 'automatización'],
    installCmd: 'npx tooldev-skills install codex',
    docsUrl: 'https://openai.com/codex',
    available: false,
  },
  {
    id: 'copilot',
    name: 'GitHub Copilot',
    maker: 'GitHub',
    description: 'Asistente de código integrado en VS Code y GitHub. Sugerencias inline, chat y pull request summaries.',
    icon: 'tabler:git-branch',
    color: '#8B5CF6',
    tags: ['vscode', 'sugerencias', 'github'],
    installCmd: 'npx tooldev-skills install github-copilot',
    docsUrl: 'https://github.com/features/copilot',
    available: false,
  },
  {
    id: 'gemini',
    name: 'Gemini',
    maker: 'Google',
    description: 'Modelo multimodal de Google. Ideal para análisis de imágenes, código, documentos extensos y tareas complejas.',
    icon: 'tabler:sparkles',
    color: '#4285F4',
    tags: ['multimodal', 'análisis', 'google'],
    installCmd: 'npx tooldev-skills install gemini',
    docsUrl: 'https://gemini.google.com',
    available: false,
  },
];
---

<BaseLayout
  title="Agentes de IA"
  description="Instala skills de agentes de IA en tu proyecto. Configuración y guías para Claude, Kiro, Cursor, Codex, Copilot y más."
  locale="es"
>
  <!-- Hero -->
  <section class="relative overflow-hidden py-16 md:py-20 border-b border-border font-mono">
    <div class="absolute inset-0 bg-grid pointer-events-none opacity-30" />
    <div class="container mx-auto px-4 relative">
      <p class="kicker mb-4">// AGENTES_IA</p>
      <h1 class="text-3xl md:text-4xl font-normal mb-4">
        Instala knowledge de herramientas<br class="hidden md:block" />
        <span class="text-accent-lime">en tu agente favorito</span>
      </h1>
      <p class="text-sm md:text-base text-muted-foreground max-w-2xl">
        Cada agente puede usar skills de ToolDev para conocer mejor las herramientas que usas.
        Instala con un solo comando.
      </p>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="py-10 border-b border-border font-mono">
    <div class="container mx-auto px-4 max-w-3xl">
      <p class="kicker mb-6 text-center">¿Cómo funciona?</p>
      <div class="grid grid-cols-1 md:grid-cols-3 border-t border-l border-border">
        <div class="flex flex-col items-center text-center gap-2 p-5 border-r border-b border-border">
          <div class="size-8 rounded-[3px] border border-accent-lime flex items-center justify-center text-accent-lime text-sm">1</div>
          <p class="text-sm">Elige tu agente</p>
          <p class="text-xs text-muted-foreground">Selecciona el asistente de IA que usas en tu día a día</p>
        </div>
        <div class="flex flex-col items-center text-center gap-2 p-5 border-r border-b border-border">
          <div class="size-8 rounded-[3px] border border-accent-lime flex items-center justify-center text-accent-lime text-sm">2</div>
          <p class="text-sm">Copia el comando</p>
          <p class="text-xs text-muted-foreground">Ejecuta el comando npx en la raíz de tu proyecto</p>
        </div>
        <div class="flex flex-col items-center text-center gap-2 p-5 border-r border-b border-border">
          <div class="size-8 rounded-[3px] border border-accent-lime flex items-center justify-center text-accent-lime text-sm">3</div>
          <p class="text-sm">Tu agente aprende</p>
          <p class="text-xs text-muted-foreground">El archivo SKILL.md se instala en .agents/skills/ y tu agente lo detecta automáticamente</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Grid de agentes -->
  <section class="py-12 font-mono">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="flex items-center justify-between mb-8">
        <p class="kicker">Agentes disponibles</p>
        <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{agents.length} agentes</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-border">
        {agents.map((agent) => (
          <div class="group relative flex flex-col p-5 border-r border-b border-border hover:bg-muted/40 transition-colors">
            <!-- Header -->
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <Icon name={agent.icon} class="text-accent-lime shrink-0" width="20" height="20" />
                <div>
                  <h3 class="text-sm">{agent.name}</h3>
                  <p class="text-[11px] text-muted-foreground">{agent.maker}</p>
                </div>
              </div>
              {agent.available ? (
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-accent-lime text-accent-lime">Disponible</span>
              ) : (
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">Próximamente</span>
              )}
            </div>

            <!-- Description -->
            <p class="text-xs text-muted-foreground leading-relaxed mb-3 flex-1">
              {agent.description}
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1 mb-4">
              {agent.tags.map((tag) => (
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">
                  {tag}
                </span>
              ))}
            </div>

            <!-- Install command -->
            <div class="flex items-center gap-0 border border-border overflow-hidden text-xs mb-3">
              <div class="flex items-center gap-1.5 px-2.5 py-2 border-r border-border shrink-0">
                <Icon name="tabler:terminal-2" width="12" height="12" class="text-accent-lime" />
              </div>
              <span class="flex-1 px-2.5 py-2 text-foreground/40 truncate select-all line-through">
                {agent.installCmd}
              </span>
              <span class="px-2 py-1 text-[10px] text-muted-foreground border-l border-border shrink-0">
                pronto
              </span>
            </div>

            <!-- Actions -->
            <div class="flex gap-2">
              <a
                href={agent.docsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-[3px] border border-border text-xs text-muted-foreground hover:text-foreground transition-colors"
              >
                <Icon name="tabler:external-link" width="12" height="12" class="text-current" />
                Documentación
              </a>
              <a
                href="/skills"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-[3px] border border-accent-lime text-xs text-accent-lime hover:bg-accent-lime/10 transition-colors"
              >
                <Icon name="tabler:info-circle" width="12" height="12" class="text-current" />
                Cómo instalar
              </a>
            </div>
          </div>
        ))}
      </div>

      <!-- Planes de precios Kiro -->
      <div class="mt-12">
        <div class="flex items-center gap-3 mb-6">
          <Icon name="tabler:rocket" width="18" height="18" class="text-accent-lime" />
          <div>
            <p class="kicker">Planes de Kiro</p>
            <p class="text-xs text-muted-foreground mt-1">Precios verificados desde <a href="https://kiro.dev/pricing/" target="_blank" rel="noopener noreferrer" class="underline hover:text-foreground">kiro.dev/pricing</a></p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 border-t border-l border-border">
          <!-- Free -->
          <div class="flex flex-col p-4 border-r border-b border-border">
            <div class="mb-3">
              <span class="text-[10px] uppercase tracking-widest text-muted-foreground">Free</span>
              <div class="flex items-end gap-1 mt-1">
                <span class="text-xl">$0</span>
                <span class="text-xs text-muted-foreground mb-1">/mes</span>
              </div>
            </div>
            <ul class="flex flex-col gap-1.5 text-xs text-muted-foreground flex-1">
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />50 créditos/mes</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Chat y vibe coding</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:x" width="12" height="12" class="text-muted-foreground/40 mt-0.5 shrink-0" />Sin specs</li>
            </ul>
            <div class="mt-3 pt-3 border-t border-border">
              <span class="text-[10px] text-muted-foreground">Trial: 500 créditos por 14 días</span>
            </div>
          </div>

          <!-- Pro -->
          <div class="flex flex-col p-4 border-r border-b border-border">
            <div class="mb-3">
              <span class="text-[10px] uppercase tracking-widest text-muted-foreground">Pro</span>
              <div class="flex items-end gap-1 mt-1">
                <span class="text-xl">$19</span>
                <span class="text-xs text-muted-foreground mb-1">/mes</span>
              </div>
            </div>
            <ul class="flex flex-col gap-1.5 text-xs text-muted-foreground flex-1">
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />1,000 créditos/mes</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Specs incluidas</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Hooks y steering</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Todos los modelos</li>
            </ul>
          </div>

          <!-- Pro+ -->
          <div class="flex flex-col p-4 border-r border-b border-accent-lime relative">
            <div class="absolute -top-2.5 left-1/2 -translate-x-1/2">
              <span class="text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-[2px] bg-accent-lime text-accent-lime-foreground">Popular</span>
            </div>
            <div class="mb-3">
              <span class="text-[10px] uppercase tracking-widest text-accent-lime">Pro+</span>
              <div class="flex items-end gap-1 mt-1">
                <span class="text-xl">$39</span>
                <span class="text-xs text-muted-foreground mb-1">/mes</span>
              </div>
            </div>
            <ul class="flex flex-col gap-1.5 text-xs text-muted-foreground flex-1">
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />2,000 créditos/mes</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Todo lo de Pro</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Subagentes custom</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Powers</li>
            </ul>
            <div class="mt-3 pt-3 border-t border-border">
              <span class="text-[10px] text-accent-lime">Recomendado para startups</span>
            </div>
          </div>

          <!-- Pro Max -->
          <div class="flex flex-col p-4 border-r border-b border-border">
            <div class="mb-3">
              <span class="text-[10px] uppercase tracking-widest text-muted-foreground">Pro Max</span>
              <div class="flex items-end gap-1 mt-1">
                <span class="text-xl">$100</span>
                <span class="text-xs text-muted-foreground mb-1">/mes</span>
              </div>
            </div>
            <ul class="flex flex-col gap-1.5 text-xs text-muted-foreground flex-1">
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />5,000 créditos/mes</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Todo lo de Pro+</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Modelos premium</li>
            </ul>
          </div>

          <!-- Power -->
          <div class="flex flex-col p-4 border-r border-b border-border">
            <div class="mb-3">
              <span class="text-[10px] uppercase tracking-widest text-muted-foreground">Power</span>
              <div class="flex items-end gap-1 mt-1">
                <span class="text-xl">$200</span>
                <span class="text-xs text-muted-foreground mb-1">/mes</span>
              </div>
            </div>
            <ul class="flex flex-col gap-1.5 text-xs text-muted-foreground flex-1">
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Créditos enterprise</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Todo de Pro Max</li>
              <li class="flex items-start gap-1.5"><Icon name="tabler:check" width="12" height="12" class="text-accent-lime mt-0.5 shrink-0" />Uso intensivo</li>
            </ul>
            <div class="mt-3 pt-3 border-t border-border">
              <span class="text-[10px] text-muted-foreground">Estudiantes: 1K créditos/mes gratis</span>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-12 p-6 border border-border text-center">
        <Icon name="tabler:bulb" width="24" height="24" class="text-accent-lime mx-auto mb-2" />
        <h3 class="text-sm mb-1">¿Usas otro agente?</h3>
        <p class="text-sm text-muted-foreground mb-4">
          Las skills de ToolDev son archivos markdown estándar compatibles con cualquier agente que soporte el formato SKILL.md.
        </p>
        <a
          href="/skills"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-[3px] bg-primary text-primary-foreground text-sm hover:opacity-90 transition-opacity"
        >
          <Icon name="tabler:terminal-2" width="16" height="16" class="text-current" />
          Ver cómo instalar skills
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
