---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

const agents = [
  {
    id: 'claude',
    name: 'Claude',
    maker: 'Anthropic',
    description: "AI assistant with advanced reasoning, code analysis, writing and precise long-form responses.",
    icon: 'tabler:brain',
    color: '#D97706',
    tags: ['code', 'analysis', 'writing'],
    installCmd: 'npx tooldev-skills install claude',
    docsUrl: 'https://docs.anthropic.com',
    available: false,
  },
  {
    id: 'kiro',
    name: 'Kiro',
    maker: 'Amazon Web Services',
    description: 'AI-powered IDE for spec-driven development. Automatically generates requirements, design and tasks.',
    icon: 'tabler:rocket',
    color: '#6366F1',
    tags: ['ide', 'specs', 'tasks'],
    installCmd: 'npx tooldev-skills install kiro',
    docsUrl: 'https://kiro.dev',
    available: false,
  },
  {
    id: 'cursor',
    name: 'Cursor',
    maker: 'Cursor',
    description: 'AI-first code editor that understands your entire codebase. Best for refactoring and code generation.',
    icon: 'tabler:cursor-text',
    color: '#10B981',
    tags: ['editor', 'code', 'refactor'],
    installCmd: 'npx tooldev-skills install cursor',
    docsUrl: 'https://cursor.sh',
    available: false,
  },
  {
    id: 'codex',
    name: 'Codex',
    maker: 'OpenAI',
    description: "OpenAI's coding agent that can complete full engineering tasks in a secure sandbox environment.",
    icon: 'tabler:code',
    color: '#059669',
    tags: ['code', 'agent', 'automation'],
    installCmd: 'npx tooldev-skills install codex',
    docsUrl: 'https://openai.com/codex',
    available: false,
  },
  {
    id: 'copilot',
    name: 'GitHub Copilot',
    maker: 'GitHub',
    description: 'Code assistant integrated in VS Code and GitHub. Inline suggestions, chat and pull request summaries.',
    icon: 'tabler:git-branch',
    color: '#8B5CF6',
    tags: ['vscode', 'suggestions', 'github'],
    installCmd: 'npx tooldev-skills install github-copilot',
    docsUrl: 'https://github.com/features/copilot',
    available: false,
  },
  {
    id: 'gemini',
    name: 'Gemini',
    maker: 'Google',
    description: "Google's multimodal model. Great for image analysis, code, large documents and complex tasks.",
    icon: 'tabler:sparkles',
    color: '#4285F4',
    tags: ['multimodal', 'analysis', 'google'],
    installCmd: 'npx tooldev-skills install gemini',
    docsUrl: 'https://gemini.google.com',
    available: false,
  },
];
---

<BaseLayout
  title="AI Agents"
  description="Install AI agent skills in your project. Setup guides for Claude, Kiro, Cursor, Codex, Copilot and more."
  locale="en"
>
  <section class="relative overflow-hidden py-16 md:py-20 border-b border-border font-mono">
    <div class="absolute inset-0 bg-grid pointer-events-none opacity-30" />
    <div class="container mx-auto px-4 relative">
      <p class="kicker mb-4">// AI_AGENTS</p>
      <h1 class="text-3xl md:text-4xl font-normal mb-4">
        Install tool knowledge<br class="hidden md:block" />
        <span class="text-accent-lime">into your favorite agent</span>
      </h1>
      <p class="text-sm md:text-base text-muted-foreground max-w-2xl">
        Each agent can use ToolDev skills to better understand the tools you work with.
        Install with a single command.
      </p>
    </div>
  </section>

  <section class="py-10 border-b border-border font-mono">
    <div class="container mx-auto px-4 max-w-3xl">
      <p class="kicker mb-6 text-center">How it works</p>
      <div class="grid grid-cols-1 md:grid-cols-3 border-t border-l border-border">
        <div class="flex flex-col items-center text-center gap-2 p-5 border-r border-b border-border">
          <div class="size-8 rounded-[3px] border border-accent-lime flex items-center justify-center text-accent-lime text-sm">1</div>
          <p class="text-sm">Choose your agent</p>
          <p class="text-xs text-muted-foreground">Pick the AI assistant you use daily</p>
        </div>
        <div class="flex flex-col items-center text-center gap-2 p-5 border-r border-b border-border">
          <div class="size-8 rounded-[3px] border border-accent-lime flex items-center justify-center text-accent-lime text-sm">2</div>
          <p class="text-sm">Copy the command</p>
          <p class="text-xs text-muted-foreground">Run the npx command at your project root</p>
        </div>
        <div class="flex flex-col items-center text-center gap-2 p-5 border-r border-b border-border">
          <div class="size-8 rounded-[3px] border border-accent-lime flex items-center justify-center text-accent-lime text-sm">3</div>
          <p class="text-sm">Your agent learns</p>
          <p class="text-xs text-muted-foreground">The SKILL.md file installs to .agents/skills/ and your agent detects it automatically</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 font-mono">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="flex items-center justify-between mb-8">
        <p class="kicker">Available agents</p>
        <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{agents.length} agents</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border-t border-l border-border">
        {agents.map((agent) => (
          <div class="group relative flex flex-col p-5 border-r border-b border-border hover:bg-muted/40 transition-colors">
            <div class="flex items-start justify-between mb-3">
              <div class="flex items-center gap-3">
                <Icon name={agent.icon} class="text-accent-lime shrink-0" width="20" height="20" />
                <div>
                  <h3 class="text-sm">{agent.name}</h3>
                  <p class="text-[11px] text-muted-foreground">{agent.maker}</p>
                </div>
              </div>
              {agent.available ? (
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-accent-lime text-accent-lime">Available</span>
              ) : (
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">Coming soon</span>
              )}
            </div>
            <p class="text-xs text-muted-foreground leading-relaxed mb-3 flex-1">{agent.description}</p>
            <div class="flex flex-wrap gap-1 mb-4">
              {agent.tags.map((tag) => (
                <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-[2px] border border-border text-muted-foreground">{tag}</span>
              ))}
            </div>
            <div class="flex items-center gap-0 border border-border overflow-hidden text-xs mb-3">
              <div class="flex items-center gap-1.5 px-2.5 py-2 border-r border-border shrink-0">
                <Icon name="tabler:terminal-2" width="12" height="12" class="text-accent-lime" />
              </div>
              <span class="flex-1 px-2.5 py-2 text-foreground/70 truncate select-all">{agent.installCmd}</span>
            </div>
            <div class="flex gap-2">
              <a href={agent.docsUrl} target="_blank" rel="noopener noreferrer"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-[3px] border border-border text-xs text-muted-foreground hover:text-foreground transition-colors">
                <Icon name="tabler:external-link" width="12" height="12" class="text-current" />
                Docs
              </a>
              <a href="/en/skills"
                class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-[3px] border border-accent-lime text-xs text-accent-lime hover:bg-accent-lime/10 transition-colors">
                <Icon name="tabler:info-circle" width="12" height="12" class="text-current" />
                How to install
              </a>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-12 p-6 border border-border text-center">
        <Icon name="tabler:bulb" width="24" height="24" class="text-accent-lime mx-auto mb-2" />
        <h3 class="text-sm mb-1">Using a different agent?</h3>
        <p class="text-sm text-muted-foreground mb-4">
          ToolDev skills are standard markdown files compatible with any agent that supports the SKILL.md format.
        </p>
        <a href="/en/skills"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-[3px] bg-primary text-primary-foreground text-sm hover:opacity-90 transition-opacity">
          <Icon name="tabler:terminal-2" width="16" height="16" class="text-current" />
          See how to install skills
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
